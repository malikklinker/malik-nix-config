/* Generated by theme-set. Vivaldi reads this on its next full restart. */
#browser {
  --desktop-background: @BACKGROUND@;
  --desktop-surface: @SURFACE@;
  --desktop-overlay: @OVERLAY@;
  --desktop-text: @TEXT@;
  --desktop-subtext: @SUBTEXT@;
  --desktop-accent: @ACCENT@;
  color-scheme: @VARIANT@;
}
